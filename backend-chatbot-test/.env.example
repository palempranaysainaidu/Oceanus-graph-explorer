# CognoDB (Neo4j-compatible graph database)
# Copy to backend-chatbot-test/.env and fill in your password from the CognoDB download file.
COGNODB_URI=bolt+s://db-4dcfe13c.databases.cognodb.com
COGNODB_USER=cognodb
COGNODB_PASSWORD=your-password-here

# Legacy aliases (optional — cognodb_client reads these as fallbacks)
NEO4J_URI=bolt+s://db-4dcfe13c.databases.cognodb.com
NEO4J_USER=cognodb
NEO4J_PASS=your-password-here

# LLM (optional — agents degrade gracefully without it)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: CockroachDB for live measurement queries (CSV fallback works without it)
DATABASE_URL=

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
